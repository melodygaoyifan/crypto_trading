# HMATS v6.8.0 — API Container
# Read-only operational API (no trade execution)
#
# Build:  docker build -f Dockerfile.api -t hmats-api:6.8.0 .
# Run:    docker run -d --name hmats-api -p 127.0.0.1:8080:8080 \
#           -v hmats-data:/opt/hmats/data:ro \
#           -v hmats-logs:/opt/hmats/logs:ro \
#           hmats-api:6.8.0

FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HMATS_BASE_DIR=/opt/hmats \
    HMATS_STATE_DIR=/opt/hmats/data \
    HMATS_LOG_DIR=/opt/hmats/logs

WORKDIR /opt/hmats

RUN groupadd --gid 1000 hmats && \
    useradd --uid 1000 --gid hmats --shell /bin/bash --create-home hmats && \
    mkdir -p /opt/hmats/data /opt/hmats/logs && \
    chown -R hmats:hmats /opt/hmats

RUN pip install --no-cache-dir fastapi uvicorn[standard]

COPY --chown=hmats:hmats api/ ./api/

VOLUME ["/opt/hmats/data", "/opt/hmats/logs"]

USER hmats

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')" || exit 1

CMD ["uvicorn", "api.server:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
