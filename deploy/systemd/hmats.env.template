# ================================================================================
# HMATS Environment Configuration
# ================================================================================
# Location: /etc/hmats/hmats.env
# Permissions: chmod 600 /etc/hmats/hmats.env
#              chown hmats:hmats /etc/hmats/hmats.env
#
# WARNING: This file contains sensitive API credentials!
# ================================================================================

# =============================================================================
# KRAKEN API CREDENTIALS (REQUIRED for trading)
# =============================================================================

# Kraken API Key
KRAKEN_API_KEY=your_kraken_api_key_here

# Kraken API Secret
KRAKEN_API_SECRET=your_kraken_api_secret_here

# =============================================================================
# HMATS RUNTIME CONFIGURATION
# =============================================================================

# Base directory
HMATS_BASE_DIR=/opt/hmats

# Model directory (where trained models are stored)
HMATS_MODEL_DIR=/opt/hmats/models/current

# Log directory
HMATS_LOG_DIR=/var/log/hmats

# State directory (for hot restart persistence)
HMATS_STATE_DIR=/var/lib/hmats

# Configuration file
HMATS_CONFIG_FILE=/opt/hmats/configs/cloud_production.json

# Log level (DEBUG, INFO, WARNING, ERROR)
HMATS_LOG_LEVEL=INFO

# Initial capital (USD) — set to actual account balance
HMATS_INITIAL_CAPITAL=10000

# =============================================================================
# OPTIONAL: ALERTS (not implemented yet)
# =============================================================================

# Telegram alerts (optional)
# HMATS_TELEGRAM_BOT_TOKEN=
# HMATS_TELEGRAM_CHAT_ID=

# Email alerts (optional)
# HMATS_ALERT_EMAIL=
# HMATS_SMTP_SERVER=
# HMATS_SMTP_USER=
# HMATS_SMTP_PASSWORD=
