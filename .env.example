# ================================================================================
# HMATS v6.5.1 - 环境变量配置文件 (Environment Variables Configuration)
# ================================================================================
# 将此文件复制为 .env 并填入实际值
# Copy this file to .env and fill in your actual values
# 
# ⚠️ 注意: 不要将 .env 提交到版本控制!
# ⚠️ WARNING: DO NOT commit .env to version control!
# ================================================================================

# =============================================================================
# KRAKEN 交易所 (REQUIRED for live/paper trading)
# =============================================================================
# 获取 API keys: https://www.kraken.com/u/security/api
# 所需权限: Query Funds, Query Open Orders & Trades, Create & Modify Orders

KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here

# Kraken SOL 存款地址 (用于链上监控)
# 逗号分隔的地址列表
KRAKEN_SOL_DEPOSIT_ADDRESSES=
KRAKEN_SOL_WALLETS=

# =============================================================================
# 外部数据源 - P0 级别 (Required for full functionality)
# =============================================================================
# 如果未设置，feeds 将以 mock 模式运行并返回中性默认值

# FRED (美联储经济数据)
# 获取 API key: https://fred.stlouisfed.org/docs/api/api_key.html
# 需要免费注册
FRED_API_KEY=your_fred_api_key_here

# Coinglass (加密衍生品数据: 资金费率, OI, 清算)
# 获取 API key: https://www.coinglass.com/developer
# 完整访问可能需要付费订阅
COINGLASS_API_KEY=your_coinglass_api_key_here

# LunarCrush (社交指标和情绪)
# 获取 API key: https://lunarcrush.com/developers
# 免费版本有速率限制
LUNARCRUSH_API_KEY=your_lunarcrush_api_key_here

# CryptoPanic (新闻聚合和情绪)
# 获取 API key: https://cryptopanic.com/developers/api/
# 免费版本可用
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key_here

# =============================================================================
# 外部数据源 - P1 级别 (Optional enhancements)
# =============================================================================

# Trading Economics (经济日历和宏观事件)
# 获取 API key: https://tradingeconomics.com/api
# 需要付费订阅
TRADING_ECONOMICS_API_KEY=

# =============================================================================
# LLM 提供商 (Optional - for explainability features)
# =============================================================================
# 仅在使用 LLM 交易解释器或情绪分析时需要
# 选择一个提供商 (推荐 Anthropic)

# Anthropic Claude API
# 获取 API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API (Anthropic 的替代方案)
# 获取 API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 通用 LLM API key (备用)
LLM_API_KEY=

# =============================================================================
# 通知系统 (Optional)
# =============================================================================

# Telegram Bot 警报
# 通过 Telegram 上的 @BotFather 创建 bot
# 通过向你的 bot 发消息并检查 https://api.telegram.org/bot<token>/getUpdates 获取 chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# SOLANA 链上数据 (Optional - for on-chain data feeds)
# =============================================================================

# Solana RPC 端点
# 免费: https://api.mainnet-beta.solana.com
# 推荐: 使用专用 RPC 提供商 (Helius, QuickNode, etc.)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# =============================================================================
# HMATS 系统配置
# =============================================================================

# 运行模式: DEV 或 PROD
# DEV: 更详细的日志，较宽松的安全检查
# PROD: 生产日志，严格的安全执行
HMATS_RUNTIME_MODE=DEV

# 配置文件路径 (可选覆盖)
HMATS_CONFIG_FILE=

# 目录路径 (可选覆盖)
HMATS_BASE_DIR=
HMATS_MODEL_DIR=
HMATS_LOG_DIR=
HMATS_STATE_DIR=
HMATS_CONFIG_DIR=

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
HMATS_LOG_LEVEL=INFO

# 模拟交易初始资金 — set to actual account balance
HMATS_INITIAL_CAPITAL=10000

# =============================================================================
# [P61 2026-04-25] Optional runtime tuning env vars (all have safe defaults)
# =============================================================================
# Cooldown for "regime change without confirmation" warning logs (default 600)
# HMATS_REGIME_WARN_COOLDOWN_SEC=600

# G6 (FullExitOptimizer) shadow mode — set to "1" to log only without acting
# HMATS_G6_SHADOW=

# Aggressive Allocator — auto-route capital to top-Sharpe strategies
# HMATS_ENABLE_AGGRESSIVE_ALLOCATOR=
# HMATS_AGGRESSIVE_ALLOCATOR_MIN_FILLS=20

# [P134 2026-04-29] USD->USDT auto-conversion before SOL/USDT BUY orders.
# Default OFF for safety. When enabled:
#   - Triggered ONLY on BUY orders for USDT-quoted pairs (currently SOL/USDT)
#   - Auto-buys USDT via Kraken USDT/USD (~21bps total cost: 1bps spread + 20bps taker fee)
#   - Per-order cap via *_MAX_USD (default $200/order)
#   - Fail-CLOSED: conversion failure -> SOL order REJECTED with PREFLIGHT_QUOTE_CONVERT_FAILED
#   - Logged at CRITICAL: every conversion shows from/to amounts in [QUOTE-CONVERT] log
# Without this: SOL LONG entries fail when USDT free balance < notional (P87 balance clamp).
# HMATS_USDT_AUTO_CONVERT_ENABLED=true
# HMATS_USDT_AUTO_CONVERT_MAX_USD=200

# =============================================================================
# [P53 2026-04-25] Removed HMATS_ENABLE_DRL / SENTIMENT / FALSE_BREAKOUT /
# SIGNAL_QUALITY env-flag block — none had readers in the live code.
# =============================================================================
# API 速率限制说明
# =============================================================================
#
# | API               | 速率限制                    |
# |-------------------|----------------------------|
# | FRED              | 120 requests/minute        |
# | Coinglass         | 根据订阅计划               |
# | LunarCrush        | 100 requests/minute (免费) |
# | CryptoPanic       | 100 requests/hour (免费)   |
# | Kraken REST       | 15 requests/second         |
# | Kraken WebSocket  | 无限制 (使用 ping/pong)    |
#
# =============================================================================
# Mock 模式说明
# =============================================================================
#
# 如果 API keys 缺失，feeds 自动使用 mock 模式:
# - Mock 模式返回中性/安全的默认值
# - 适合测试但无真实市场情报
# - 不会发出网络请求
# - 不会崩溃
#
# =============================================================================
# 生产环境检查清单
# =============================================================================
#
# [ ] KRAKEN_API_KEY 和 KRAKEN_API_SECRET 已设置
# [ ] 至少 FRED_API_KEY 已设置 (宏观数据)
# [ ] HMATS_RUNTIME_MODE=PROD
# [ ] Telegram 警报已配置 (推荐)
# [ ] 已测试 dry-run 模式
# [ ] 已检查 .env 文件权限 (chmod 600)
#
# =============================================================================
# 安全注意事项
# =============================================================================
#
# 1. 永远不要将 .env 提交到版本控制
# 2. 生产环境和开发环境使用不同的 API keys
# 3. 定期轮换 keys
# 4. 使用最小必要权限
# 5. 监控 API 使用量和异常活动
#
# ================================================================================
