# =============================================================================
# HMATS v6.8.0 — Environment Variables (Hetzner Cloud Deployment)
# =============================================================================
# Copy to .env and fill in actual values:
#   cp env/.env.template .env
#   chmod 600 .env
# =============================================================================

# --- KRAKEN (REQUIRED) ---
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- EXTERNAL DATA FEEDS (REQUIRED for full feature set) ---
FRED_API_KEY=
COINGLASS_API_KEY=
LUNARCRUSH_API_KEY=
CRYPTOPANIC_API_KEY=
CRYPTOCOMPARE_API_KEY=

# --- OPTIONAL DATA FEEDS ---
TRADING_ECONOMICS_API_KEY=
KAGGLE_KEY=
CRYPTO_DATA_DOWNLOAD_API_TOKEN=

# --- SOLANA RPC (optional) ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- KRAKEN DERIVATIVES (optional, OFF by default) ---
# Mode: off | data_only | live
KRAKEN_DERIVS_MODE=off
# Only needed for LIVE mode:
# KRAKEN_DERIVS_API_KEY=
# KRAKEN_DERIVS_API_SECRET=
# KRAKEN_DERIVS_MAX_LEVERAGE=5.0

# --- HMATS RUNTIME ---
HMATS_RUNTIME_MODE=PROD
HMATS_LOG_LEVEL=INFO
HMATS_INITIAL_CAPITAL=10000

# --- NOTIFICATIONS (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM (optional, not used in bounded-live) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
