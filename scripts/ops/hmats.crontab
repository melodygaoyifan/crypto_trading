50 6 * * 1 docker exec hmats-engine python -X utf8 scripts/september_check.py --countdown-only >> /home/hmats/evidence_cron.log 2>&1
# [P389c] Weekly forward-accumulation of the derivatives-positioning bundle (OI/liq/funding/long-short ratio).
# Host venv (runtime image lacks pyarrow); MERGE-accumulates (P266) into a persistent host dir. Feed for the P388 OI-lead OOS validation.
55 6 * * 1 cd /home/hmats/hmats/app && HMATS_COINGLASS_DIR=/home/hmats/coinglass_history /home/hmats/cg_venv/bin/python -X utf8 training/scripts/fetch_coinglass_history.py --interval 4h >> /home/hmats/coinglass_accum.log 2>&1
57 6 * * 1 cd /home/hmats/hmats/app && HMATS_COINGLASS_DIR=/home/hmats/coinglass_history /home/hmats/cg_venv/bin/python -X utf8 training/scripts/fetch_coinglass_history.py --interval 1d >> /home/hmats/coinglass_accum.log 2>&1
47 6 * * 1 docker exec hmats-engine python -X utf8 scripts/conviction_sizing_review.py >> /home/hmats/evidence_cron.log 2>&1
# [P423] standing-decision alarm (exit 3 = OVERDUE; never edits config) + realized attribution by decider
52 6 * * 1 docker exec hmats-engine python -X utf8 scripts/decision_check.py >> /home/hmats/evidence_cron.log 2>&1
32 6 * * 1 docker exec hmats-engine python -X utf8 analytics/sleeve_attribution/decider_attribution.py >> /home/hmats/evidence_cron.log 2>&1
# [P424] the calbasis 2026-11-10 pre-committed re-read, MECHANIZED: a pooled 110d calbasis report
# priced on Kraken public OHLC (P423 --allow-kraken-ohlcv; the parquets are not in the image), then
# the gate itself. Exit 0 = not due / keep accruing, 2 = refusal, 3 = a criterion fired (owed a
# human decision via pending_decisions.json). 110d spans the ledger (start 2026-08-16) through early
# December inside Kraken's 720-bar window; a shorter window would REFUSE (P421 mitigation c).
54 6 * * 1 docker exec hmats-engine sh -c 'python -X utf8 analytics/shadow_ic/compute_shadow_ic.py --ledger-dir /opt/hmats/data/strategy_shadow --window-days 110 --prefixes calbasis --pool-assets --allow-kraken-ohlcv --output /opt/hmats/data/evidence_reports/shadow_ic_calbasis_$(date -u +\%Y\%m\%d).json && python -X utf8 scripts/calbasis_check.py --report /opt/hmats/data/evidence_reports/shadow_ic_calbasis_$(date -u +\%Y\%m\%d).json' >> /home/hmats/evidence_cron.log 2>&1
# [P425] the skew+ETF ETH agree-gate pre-committed read (2026-12-12): a PER-ASSET 75d skewetf report
# (the skewetf_agree ETH record is what the gate scores; NOT --pool-assets -- the question is ETH),
# Kraken-priced (P423), then the gate. Exit 0 = not due / keep accruing, 2 = refusal, 3 = PROMOTE fired
# (owed a human decision via pending_decisions.json: skewetf_eth_agree_read). 75d spans the replica-fed
# ledger (start 2026-10-13) through the read date inside Kraken's 720-bar window.
56 6 * * 1 docker exec hmats-engine sh -c 'python -X utf8 analytics/shadow_ic/compute_shadow_ic.py --ledger-dir /opt/hmats/data/strategy_shadow --window-days 75 --prefixes skewetf --allow-kraken-ohlcv --output /opt/hmats/data/evidence_reports/shadow_ic_skewetf_$(date -u +\%Y\%m\%d).json && python -X utf8 scripts/skewetf_agree_check.py --report /opt/hmats/data/evidence_reports/shadow_ic_skewetf_$(date -u +\%Y\%m\%d).json' >> /home/hmats/evidence_cron.log 2>&1
# [P1-6] weekly unit economics from the venue ledger (Phase 0 round-trip model, read-only get_fills).
58 6 * * 1 docker exec hmats-engine python -X utf8 scripts/weekly_unit_economics.py >> /home/hmats/evidence_cron.log 2>&1
