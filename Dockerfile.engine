# HMATS v6.8.0 — Engine Container
# Runs the trading engine (main.py) with 4H tick loop
#
# Build:  docker build -f Dockerfile.engine -t hmats-engine:6.8.0 .
# Run:    docker run -d --name hmats-engine --env-file .env \
#           -v hmats-models:/opt/hmats/models:ro \
#           -v hmats-data:/opt/hmats/data \
#           -v hmats-logs:/opt/hmats/logs \
#           hmats-engine:6.8.0 --mode paper

FROM python:3.12-slim-bookworm AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /opt/hmats

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates gcc g++ && \
    rm -rf /var/lib/apt/lists/*

# Non-root user
RUN groupadd --gid 1000 hmats && \
    useradd --uid 1000 --gid hmats --shell /bin/bash --create-home hmats && \
    mkdir -p /opt/hmats/data /opt/hmats/logs /opt/hmats/models && \
    chown -R hmats:hmats /opt/hmats

# Python deps
COPY --chown=hmats:hmats requirements-runtime.txt ./
RUN pip install --no-cache-dir -r requirements-runtime.txt \
    && pip install --no-cache-dir ccxt filterpy ta \
    && pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir sb3-contrib stable-baselines3 joblib scikit-learn \
    && pip install --no-cache-dir transformers \
    && pip install --no-cache-dir tiktoken sentencepiece protobuf

# Application code
COPY --chown=hmats:hmats main.py ./
COPY --chown=hmats:hmats core/ ./core/
COPY --chown=hmats:hmats agents/ ./agents/
COPY --chown=hmats:hmats analytics/ ./analytics/
COPY --chown=hmats:hmats configs/ ./configs/
COPY --chown=hmats:hmats defense/ ./defense/
COPY --chown=hmats:hmats drl/ ./drl/
COPY --chown=hmats:hmats exchange/ ./exchange/
COPY --chown=hmats:hmats execution/ ./execution/
COPY --chown=hmats:hmats infra/ ./infra/
COPY --chown=hmats:hmats integration/ ./integration/
COPY --chown=hmats:hmats liquidity/ ./liquidity/
COPY --chown=hmats:hmats market/ ./market/
COPY --chown=hmats:hmats orchestration/ ./orchestration/
COPY --chown=hmats:hmats portfolio/ ./portfolio/
COPY --chown=hmats:hmats risk/ ./risk/
COPY --chown=hmats:hmats signals/ ./signals/
COPY --chown=hmats:hmats strategies/ ./strategies/
COPY --chown=hmats:hmats data_mgmt/ ./data_mgmt/
COPY --chown=hmats:hmats tools/ ./tools/
COPY --chown=hmats:hmats dashboard/ ./dashboard/

# Training subset needed for DRL (TQC) + DT model deserialization
COPY --chown=hmats:hmats training/__init__.py ./training/
COPY --chown=hmats:hmats training/models/__init__.py training/models/film_extractor.py training/models/feature_extractors.py ./training/models/
COPY --chown=hmats:hmats training/drl/__init__.py training/drl/features.py training/drl/model.py training/drl/train_decision_transformer_v32.py training/drl/oracle_tqc_teacher.py ./training/drl/
# [P214] Wavelet denoise — this is NOT training-only code. The LIVE feature
# pipeline imports it every tick (data_mgmt/market_data_pipeline.py:855) to
# produce 5 of the 122 model features. It was never copied, so the import raised
# ModuleNotFoundError, the except fell back to RAW values, and serving silently
# disagreed with training on those 5 columns for as long as this image has
# existed. Needs PyWavelets in requirements-runtime.txt (added in the same
# change) — shipping the module without the library just moves the failure.
COPY --chown=hmats:hmats training/scripts/__init__.py training/scripts/wavelet_denoise.py ./training/scripts/
# [P214] Sequence-alpha class definitions. The CHECKPOINTS are in the models
# volume but the classes that unpickle them were not in the image, so live
# logged `No module named 'training.model_alpha'` and model_alpha — an ADVISE
# agent — emitted +0.00/0.00 for BTC and SOL (ETH happened to load). torch only.
COPY --chown=hmats:hmats training/model_alpha/__init__.py training/model_alpha/sequence_alpha_model.py ./training/model_alpha/
# Exit-DRL training package — runtime needs DiscreteActor + DiscreteQCritic for
# checkpoint deserialization and the build_state helper for state construction.
COPY --chown=hmats:hmats training/exit_drl ./training/exit_drl
# Sentiment v2.2 training script — runtime needs SentimentConfigV22 +
# SentimentModelV22 class definitions to unpickle models/sentiment_v22_best.pt
# (P5 __main__ alias pattern; see agents/sentiment_deberta.py:54-60). Without
# this copy, [L2_SENTIMENT] Failed to load: No module named 'training.sentiment'
# fires at every container start and L2 sentiment stays UNAVAILABLE forever.
COPY --chown=hmats:hmats training/sentiment/__init__.py training/sentiment/train_sentiment_agent_v22.py ./training/sentiment/
# Validator outputs — read by risk/exit_drl_promotion_gate.py for Sharpe lift evidence.
COPY --chown=hmats:hmats data/exit_drl_validation ./data/exit_drl_validation

# [P190] Read-only diagnostics that CLAUDE.md documents as
# `docker exec hmats-engine python -X utf8 scripts/<x>.py`. They were not in the
# image, so every one of those documented commands failed with "can't open
# file" — CLAUDE.md:1118 had already noticed ("scp the script in first —
# scripts/ isn't baked into the image") without the other entries being fixed.
#
# This is an ALLOWLIST, not `COPY scripts/`. scripts/ also holds
# launch_live.py, coinbase_test_order.py and coinbase_flatten.py; baking those
# in would put order-placing code inside the live trading container, which P141
# exists to prevent. Each file below is stdlib-only and reads data/logs.
#
# Gate: tests/test_ops_docs_reference_real_commands.py asserts every script
# named in a documented `docker exec` command appears here.
COPY --chown=hmats:hmats scripts/why_no_trade.py scripts/kq_strategy_diagnostic.py scripts/agent_audit_16.py scripts/trend_regime_review.py ./scripts/

VOLUME ["/opt/hmats/models", "/opt/hmats/data", "/opt/hmats/logs"]

USER hmats

HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 \
    CMD python -c "\
import json, time; \
from pathlib import Path; \
s = Path('/opt/hmats/data/dashboard_state.json'); \
assert s.exists(), 'no state file'; \
d = json.loads(s.read_text()); \
assert 'updated_at' in d, 'no timestamp'; \
print('OK')" || exit 1

ENTRYPOINT ["python", "main.py"]
CMD ["--mode", "verify"]
