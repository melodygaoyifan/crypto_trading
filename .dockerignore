__pycache__
*.pyc
*.pyo
.git
.gitignore
.env
.env.*
env/
venv/
venv_cuda/
.venv/
logs/
archive/
tests/
/models/
docs/
reports/
scripts/
# [P192] Dockerfile.engine COPYs an ALLOWLIST of stdlib-only diagnostic
# scripts (four since P213). `scripts/` above excludes the whole directory
# from the build context, so those COPYs cannot resolve and the image fails
# to build. The exclusion stays — scripts/ also holds launch_live.py and
# coinbase_*.py, and baking order-placing code into the live container is
# what P141 exists to prevent. Re-include exactly the allowlisted files,
# nothing else. Keep this list in sync with the scripts COPY line in
# Dockerfile.engine (search "COPY scripts/" — a hardcoded line number here
# drifted once already, P253).
!scripts/why_no_trade.py
!scripts/kq_strategy_diagnostic.py
!scripts/agent_audit_16.py
# [P213] The trend_regime_gate promotion evidence (data/trend_regime_shadow.jsonl)
# is written to the hmats-data VOLUME, so the reader belongs where the data is —
# otherwise the only way to read it is to scp the ledger to a laptop. Stdlib-only;
# reads the ledger + Kraken's PUBLIC OHLC endpoint; places no orders.
!scripts/trend_regime_review.py
!scripts/fill_quality_review.py
pytorch_build/
deploy/
data/diagnostics/
data/shadow_ledger/
data/live_experiences/
data/drl_training/
*.md
!requirements*.txt
*.log
*.parquet

# Exclude training binaries but keep .py modules
training/training_data/
training/sentiment/
training/run_training.py
training/train_*.py
# Exit DRL needs DiscreteActor + DiscreteQCritic + build_state at runtime —
# allow the full package back in even though `train_*.py` and `train_*.py`
# glob matches train_exit_sac.py.
!training/exit_drl
!training/exit_drl/**
# Sentiment v2.2 — runtime needs the class definitions to unpickle
# models/sentiment_v22_best.pt (P5 __main__ alias pattern, see
# agents/sentiment_deberta.py:54-60). Keep the training/sentiment/ exclude
# above; re-include just the two files the runtime imports. The .pt/.pkl
# excludes below still apply, so the 748MB checkpoint stays out of the image.
!training/sentiment/__init__.py
!training/sentiment/train_sentiment_agent_v22.py
training/**/*.pt
training/**/*.pkl
training/**/*.zip
training/**/*.npz
training/**/*.csv

# Exclude root-level binaries
*.db
*.db-shm
*.db-wal
*.bak*
*.tfevents*
docker-compose*.yml
Dockerfile*
.dockerignore
audit_report.json
audit_results/
ALL_USER_MESSAGES.txt
extracted_user_messages.txt
hmats_audit.db*
