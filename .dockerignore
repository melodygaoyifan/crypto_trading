# Exclude training binaries but keep .py modules
training/training_data/
training/sentiment/
training/run_training.py
training/train_*.py
# Exit DRL needs DiscreteActor + DiscreteQCritic + build_state at runtime —
# allow the full package back in even though `train_*.py` and `train_*.py`
# glob matches train_exit_sac.py.
!training/exit_drl
!training/exit_drl/**
training/**/*.pt
training/**/*.pkl
training/**/*.zip
training/**/*.npz
training/**/*.csv

# Exclude root-level binaries
*.db
*.db-shm
*.db-wal
*.bak*
*.tfevents*
docker-compose*.yml
Dockerfile*
.dockerignore
audit_report.json
audit_results/
ALL_USER_MESSAGES.txt
extracted_user_messages.txt
hmats_audit.db*
